# Copia este archivo a .env y completa los valores.
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Agrega aquí la IP pública/DNS de EC2, por ejemplo: http://3.12.34.56
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Pon 1 solo si el sitio se sirve por HTTPS
DJANGO_SECURE_COOKIES=0

POSTGRES_DB=fitlife
POSTGRES_USER=fitlife
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Aforo máximo simultáneo del centro
FITLIFE_AFORO_MAXIMO=120
